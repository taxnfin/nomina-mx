generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  NOMINISTA
  AUDITOR
}

enum Periodicidad {
  SEMANAL
  CATORCENAL
  QUINCENAL
  MENSUAL
}

enum RegimenContratacion {
  SUELDOS_SALARIOS
  ASIMILADOS_MIEMBROS_SOCIEDADES
  ASIMILADOS_COMISIONISTAS
  ASIMILADOS_HONORARIOS
  ASIMILADOS_ACCIONES
  ASIMILADOS_OTROS
  JUBILADOS
}

enum TipoJornada {
  DIURNA
  NOCTURNA
  MIXTA
  POR_HORA
  REDUCIDA
  CONTINUADA
  PARTIDA
  POR_TURNOS
}

enum TipoContrato {
  INDETERMINADO
  OBRA_DETERMINADA
  TIEMPO_DETERMINADO
  CAPACITACION_INICIAL
  PRUEBA
}

enum TipoSalario {
  FIJO
  VARIABLE
  MIXTO
}

enum EstadoEmpleado {
  ACTIVO
  BAJA
  INCAPACIDAD
  PERMISO
}

enum EstadoCorrida {
  BORRADOR
  CALCULADA
  AUTORIZADA
  TIMBRADA
  PAGADA
  CANCELADA
}

enum TipoConcepto {
  PERCEPCION
  DEDUCCION
  OTRO_PAGO
}

enum TipoIncidencia {
  FALTA
  INCAPACIDAD_ENFERMEDAD
  INCAPACIDAD_RIESGO
  INCAPACIDAD_MATERNIDAD
  PERMISO_SIN_GOCE
  PERMISO_CON_GOCE
  VACACIONES
  HORAS_EXTRA_DOBLES
  HORAS_EXTRA_TRIPLES
  DIA_DESCANSO_TRABAJADO
  PRIMA_DOMINICAL
  DIA_FESTIVO_TRABAJADO
}

enum TipoChecada {
  ENTRADA
  SALIDA
  INICIO_COMIDA
  FIN_COMIDA
}

enum OrigenChecada {
  WHATSAPP
  MANUAL
}

enum TipoSeparacion {
  RENUNCIA
  DESPIDO_JUSTIFICADO
  DESPIDO_INJUSTIFICADO
  TERMINO_CONTRATO
  MUTUO_ACUERDO
  DEFUNCION
}

model Empresa {
  id                 String   @id @default(cuid())
  razonSocial        String
  rfc                String   @unique
  regimenFiscal      String
  codigoPostal       String
  registroPatronal   String?
  primaRiesgoTrabajo Decimal  @default(0.005) @db.Decimal(9, 6)
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  usuarios         Usuario[]
  empleados        Empleado[]
  corridas         CorridaNomina[]
  bitacora         RegistroBitacora[]
  parametros       ParametroFiscal[]
  repse            RegistroRepse?
  contratos        ContratoRepse[]
  configuracionIsn ConfiguracionIsn[]
}

/// Configuración de impuesto sobre nóminas con vigencia, para que los periodos
/// ya declarados conserven la tasa que les fue aplicable.
model ConfiguracionIsn {
  id              String   @id @default(cuid())
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Primer día a partir del cual aplica esta configuración.
  vigenteDesde    DateTime @db.Date
  /// Entidad donde se causa el impuesto (catálogo c_Estado del SAT).
  claveEntidadIsn String
  /// Tasa de la empresa; si es nula se usa la del catálogo estatal.
  tasaIsn         Decimal? @db.Decimal(9, 6)
  sobretasaIsn    Decimal? @db.Decimal(9, 6)
  /// Día del mes siguiente en que vence el pago; si es nulo se usa el del catálogo.
  diaLimiteIsn    Int?
  creadoEn        DateTime @default(now())

  @@unique([empresaId, vigenteDesde])
  @@index([empresaId, vigenteDesde])
}

/// Registro de prestadora de servicios especializados ante la STPS (LFT Art. 15).
model RegistroRepse {
  id             String   @id @default(cuid())
  empresaId      String   @unique
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numeroRegistro String
  fechaRegistro  DateTime
  /// Actividades especializadas amparadas por el registro, separadas por salto de línea.
  actividades    String
  notas          String?
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt
}

/// Contrato de servicio u obra especializada que se informa en ICSOE y SISUB.
model ContratoRepse {
  id                 String    @id @default(cuid())
  empresaId          String
  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  beneficiario       String
  rfcBeneficiario    String
  objeto             String
  fechaInicio        DateTime
  fechaFin           DateTime?
  numeroTrabajadores Int       @default(0)
  /// Margen de utilidad pactado sobre el costo, en tanto por uno.
  margenUtilidad     Decimal   @default(0.15) @db.Decimal(9, 6)
  otrosCostos        Decimal   @default(0) @db.Decimal(16, 2)
  creadoEn           DateTime  @default(now())

  @@index([empresaId])
}

model Usuario {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre       String
  email        String   @unique
  hashPassword String
  rol          Rol      @default(NOMINISTA)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  corridasCreadas     CorridaNomina[] @relation("CorridaCreadaPor")
  corridasAutorizadas CorridaNomina[] @relation("CorridaAutorizadaPor")
}

model Empleado {
  id              String          @id @default(cuid())
  empresaId       String
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numeroEmpleado  String
  nombre          String
  apellidoPaterno String
  apellidoMaterno String?
  rfc             String
  curp            String
  nss             String?
  fechaNacimiento DateTime?
  fechaIngreso    DateTime
  fechaBaja       DateTime?
  motivoBaja      TipoSeparacion?
  estado          EstadoEmpleado  @default(ACTIVO)

  puesto                 String
  departamento           String?
  registroPatronal       String?
  claveEntidadFederativa String  @default("NLE")
  banco                  String?
  cuentaClabe            String?

  /// Número de WhatsApp en formato E.164 (+521...) usado por el checador.
  telefonoWhatsapp  String?
  checadorActivo    Boolean  @default(false)
  /// Horario contractual en HH:MM (hora local de la empresa).
  horaEntrada       String   @default("09:00")
  horaSalida        String   @default("18:00")
  toleranciaMinutos Int      @default(15)
  /// Días laborables como números ISO separados por coma (1=lunes … 7=domingo).
  diasLaborables    String   @default("1,2,3,4,5")
  /// Geocerca del centro de trabajo; sin coordenadas no se valida la distancia.
  latitudCentro     Decimal? @db.Decimal(10, 6)
  longitudCentro    Decimal? @db.Decimal(10, 6)
  radioMetros       Int      @default(200)
  exigeUbicacion    Boolean  @default(false)

  periodicidad  Periodicidad
  regimen       RegimenContratacion @default(SUELDOS_SALARIOS)
  tipoContrato  TipoContrato        @default(INDETERMINADO)
  tipoJornada   TipoJornada         @default(DIURNA)
  tipoSalario   TipoSalario         @default(FIJO)
  sindicalizado Boolean             @default(false)

  /// Salario diario nominal (cuota diaria) en MXN.
  salarioDiario           Decimal  @db.Decimal(14, 4)
  /// Salario base de cotización IMSS (integrado).
  salarioBaseCotizacion   Decimal  @db.Decimal(14, 4)
  diasVacacionesExtra     Int      @default(0)
  primaVacacionalPct      Decimal  @default(0.25) @db.Decimal(6, 4)
  diasAguinaldo           Int      @default(15)
  descuentoInfonavitTipo  String? // PORCENTAJE | CUOTA_FIJA | VSM
  descuentoInfonavitValor Decimal? @db.Decimal(14, 4)
  numeroCreditoInfonavit  String?
  pensionAlimenticiaTipo  String? // PORCENTAJE | CUOTA_FIJA
  pensionAlimenticiaValor Decimal? @db.Decimal(14, 4)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  recibos           Recibo[]
  incidencias       Incidencia[]
  checadas          Checada[]
  historialSalarios HistorialSalario[]
  finiquitos        Finiquito[]

  @@unique([empresaId, numeroEmpleado])
  @@unique([empresaId, telefonoWhatsapp])
  @@index([empresaId, estado])
}

/// Registro de asistencia (checador). Las checadas de WhatsApp llegan por webhook.
model Checada {
  id              String        @id @default(cuid())
  empleadoId      String
  empleado        Empleado      @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipo            TipoChecada
  ocurridoEn      DateTime
  origen          OrigenChecada @default(WHATSAPP)
  telefono        String?
  /// Identificador del mensaje del proveedor; evita duplicar reintentos del webhook.
  mensajeId       String?       @unique
  textoMensaje    String?
  latitud         Decimal?      @db.Decimal(10, 6)
  longitud        Decimal?      @db.Decimal(10, 6)
  /// Distancia a la geocerca del empleado al momento de checar.
  distanciaMetros Int?
  fueraDeRango    Boolean       @default(false)
  registradaEn    DateTime      @default(now())

  @@index([empleadoId, ocurridoEn])
}

model HistorialSalario {
  id                    String   @id @default(cuid())
  empleadoId            String
  empleado              Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  vigenteDesde          DateTime
  salarioDiario         Decimal  @db.Decimal(14, 4)
  salarioBaseCotizacion Decimal  @db.Decimal(14, 4)
  motivo                String?
  creadoEn              DateTime @default(now())

  @@index([empleadoId, vigenteDesde])
}

model PeriodoNomina {
  id           String       @id @default(cuid())
  ejercicio    Int
  periodicidad Periodicidad
  numero       Int
  fechaInicio  DateTime
  fechaFin     DateTime
  fechaPago    DateTime
  diasPeriodo  Int

  corridas CorridaNomina[]

  @@unique([ejercicio, periodicidad, numero])
  @@index([ejercicio, periodicidad])
}

model CorridaNomina {
  id          String        @id @default(cuid())
  empresaId   String
  empresa     Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  periodoId   String
  periodo     PeriodoNomina @relation(fields: [periodoId], references: [id])
  estado      EstadoCorrida @default(BORRADOR)
  descripcion String?

  totalPercepciones Decimal @default(0) @db.Decimal(16, 2)
  totalDeducciones  Decimal @default(0) @db.Decimal(16, 2)
  totalOtrosPagos   Decimal @default(0) @db.Decimal(16, 2)
  totalNeto         Decimal @default(0) @db.Decimal(16, 2)
  totalCuotasPatron Decimal @default(0) @db.Decimal(16, 2)

  creadaPorId     String?
  creadaPor       Usuario?  @relation("CorridaCreadaPor", fields: [creadaPorId], references: [id])
  autorizadaPorId String?
  autorizadaPor   Usuario?  @relation("CorridaAutorizadaPor", fields: [autorizadaPorId], references: [id])
  autorizadaEn    DateTime?
  pagadaEn        DateTime?

  /// Snapshot inmutable de los parámetros fiscales usados al calcular.
  parametrosSnapshot Json?

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  recibos Recibo[]

  @@unique([empresaId, periodoId])
  @@index([empresaId, estado])
}

model Recibo {
  id         String        @id @default(cuid())
  corridaId  String
  corrida    CorridaNomina @relation(fields: [corridaId], references: [id], onDelete: Cascade)
  empleadoId String
  empleado   Empleado      @relation(fields: [empleadoId], references: [id])

  diasPagados           Decimal @db.Decimal(9, 4)
  salarioDiario         Decimal @db.Decimal(14, 4)
  salarioBaseCotizacion Decimal @db.Decimal(14, 4)

  totalPercepciones     Decimal @default(0) @db.Decimal(16, 2)
  totalDeducciones      Decimal @default(0) @db.Decimal(16, 2)
  totalOtrosPagos       Decimal @default(0) @db.Decimal(16, 2)
  totalGravado          Decimal @default(0) @db.Decimal(16, 2)
  totalExento           Decimal @default(0) @db.Decimal(16, 2)
  isrRetenido           Decimal @default(0) @db.Decimal(16, 2)
  subsidioCausado       Decimal @default(0) @db.Decimal(16, 2)
  subsidioEntregado     Decimal @default(0) @db.Decimal(16, 2)
  imssObrero            Decimal @default(0) @db.Decimal(16, 2)
  imssPatron            Decimal @default(0) @db.Decimal(16, 2)
  infonavitPatron       Decimal @default(0) @db.Decimal(16, 2)
  retiroCesantiaVejez   Decimal @default(0) @db.Decimal(16, 2)
  impuestoEstatalNomina Decimal @default(0) @db.Decimal(16, 2)
  neto                  Decimal @default(0) @db.Decimal(16, 2)

  /// Desglose completo y auditable del cálculo (memoria de cálculo).
  memoriaCalculo Json

  uuidCfdi      String?
  fechaTimbrado DateTime?
  xmlCfdi       String?

  creadoEn DateTime @default(now())

  conceptos ConceptoRecibo[]

  @@unique([corridaId, empleadoId])
  @@index([empleadoId])
}

model ConceptoRecibo {
  id             String       @id @default(cuid())
  reciboId       String
  recibo         Recibo       @relation(fields: [reciboId], references: [id], onDelete: Cascade)
  tipo           TipoConcepto
  /// Clave del catálogo SAT (c_TipoPercepcion / c_TipoDeduccion / c_TipoOtroPago).
  claveSat       String
  clave          String
  concepto       String
  importeGravado Decimal      @default(0) @db.Decimal(16, 2)
  importeExento  Decimal      @default(0) @db.Decimal(16, 2)
  importe        Decimal      @default(0) @db.Decimal(16, 2)
  orden          Int          @default(0)

  @@index([reciboId, tipo])
}

model Incidencia {
  id          String         @id @default(cuid())
  empleadoId  String
  empleado    Empleado       @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipo        TipoIncidencia
  fechaInicio DateTime
  fechaFin    DateTime
  /// Cantidad en días u horas según el tipo de incidencia.
  cantidad    Decimal        @db.Decimal(9, 4)
  folio       String?
  comentario  String?
  aplicada    Boolean        @default(false)
  /// MANUAL o CHECADOR: las derivadas del checador se regeneran, las manuales no se tocan.
  origen      String         @default("MANUAL")
  creadaEn    DateTime       @default(now())

  @@index([empleadoId, fechaInicio])
  @@index([empleadoId, origen])
}

model Finiquito {
  id                   String         @id @default(cuid())
  empleadoId           String
  empleado             Empleado       @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipoSeparacion       TipoSeparacion
  fechaBaja            DateTime
  incluyeIndemnizacion Boolean        @default(false)
  totalPercepciones    Decimal        @db.Decimal(16, 2)
  totalDeducciones     Decimal        @db.Decimal(16, 2)
  neto                 Decimal        @db.Decimal(16, 2)
  memoriaCalculo       Json
  creadoEn             DateTime       @default(now())

  @@index([empleadoId])
}

/// Parámetros fiscales vigentes por ejercicio (UMA, salario mínimo, cuotas IMSS, ISN).
model ParametroFiscal {
  id           String    @id @default(cuid())
  empresaId    String?
  empresa      Empresa?  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ejercicio    Int
  clave        String
  valor        Decimal   @db.Decimal(18, 8)
  descripcion  String?
  vigenteDesde DateTime
  vigenteHasta DateTime?

  @@unique([ejercicio, clave, empresaId])
  @@index([ejercicio])
}

/// Renglones de las tarifas del Art. 96 LISR y del subsidio para el empleo.
model TarifaIsr {
  id             String       @id @default(cuid())
  ejercicio      Int
  periodicidad   Periodicidad
  limiteInferior Decimal      @db.Decimal(16, 2)
  limiteSuperior Decimal?     @db.Decimal(16, 2)
  cuotaFija      Decimal      @db.Decimal(16, 2)
  porcentaje     Decimal      @db.Decimal(9, 6)

  @@index([ejercicio, periodicidad, limiteInferior])
}

model TablaSubsidio {
  id             String       @id @default(cuid())
  ejercicio      Int
  periodicidad   Periodicidad
  limiteInferior Decimal      @db.Decimal(16, 2)
  limiteSuperior Decimal?     @db.Decimal(16, 2)
  subsidio       Decimal      @db.Decimal(16, 2)

  @@index([ejercicio, periodicidad, limiteInferior])
}

/// Bitácora append-only encadenada por hash (trazabilidad).
model RegistroBitacora {
  id           String   @id @default(cuid())
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  secuencia    Int      @unique @default(autoincrement())
  ocurridoEn   DateTime @default(now())
  actorId      String?
  actorEmail   String?
  actorRol     String?
  accion       String
  entidad      String
  entidadId    String?
  /// Estado anterior y posterior de la entidad afectada.
  datosAntes   Json?
  datosDespues Json?
  ip           String?
  userAgent    String?
  hashPrevio   String
  hash         String   @unique

  @@index([empresaId, entidad, entidadId])
  @@index([ocurridoEn])
}
